# 复制为同目录 .env；已有 .env 时只补充需要的键，不要覆盖密钥。
# 支持 MASSIVE_API_KEY、POLYGON_API_KEY，或 STOCK_HEATMAP_API_KEY。
POLYGON_API_KEY=

# 仅支持 Massive / Polygon 官方 HTTPS 地址。
MASSIVE_BASE_URL=https://api.massive.com

# 行情刷新周期（秒，15–3600）。动画独立运行，不会每帧访问 API。
STOCK_HEATMAP_REFRESH_SECONDS=60

# 所有请求共用串行限速器，默认约 5 次/分钟。
# 付费高频套餐可按实际额度改为 250 或 1000；429 会遵守 Retry-After。
STOCK_HEATMAP_REQUEST_GAP_MS=12000

# false 强制关闭底部行情条；也可通过 /stock-ticker on|off 保存开关。
STOCK_HEATMAP_TICKER=true

# 财报日历来自 Finnhub，和 Massive 使用不同 Key。已有该键时无需重复添加。
FINNHUB_API_KEY=
# Finnhub 请求独立串行限速（默认约 1 次/秒），整周按日请求。
STOCK_EARNINGS_REQUEST_GAP_MS=1100
