{
  "title": "自选股报价",
  "description": "交易时段每 60 秒取一次自选股和 SPY、QQQ 的快照（Massive Starter 套餐，延迟 15 分钟）；当天涨跌到档时发一行提醒和一条触发：个股 5%、8%，SPY、QQQ 2%、3%",
  "handler": "index.ts",
  "secrets": ["POLYGON_API_KEY"],
  "every": "60s",
  "when": "us-market-hours",
  "settings": { "baseUrl": "https://api.massive.com", "bands": { "default": [5, 8], "bySymbol": { "SPY": [2, 3], "QQQ": [2, 3] } } },
  "reads": ["watchlist"],
  "into": "quotes",
  "notice": "{{line}}"
}
