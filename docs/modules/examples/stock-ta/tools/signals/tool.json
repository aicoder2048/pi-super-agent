{
  "title": "技术信号",
  "description": "查已经算出来的技术信号，按数据时间倒序，默认 20 条。每条带规则、方向、data_end（数据时间）、discovered_at（发现时间）、数值、关注度和笔记出处 sources",
  "effect": "read",
  "secrets": ["TA_ROOT"],
  "input": {
    "symbol": { "type": "text", "title": "美股代码" },
    "rule_id": { "type": "text", "title": "规则编号，例如 R-MACD-3" },
    "timeframe": { "type": "text", "title": "周期，1d、1w 或 5m" },
    "direction": { "type": "text", "title": "bullish、bearish 或 neutral" },
    "attention": { "type": "text", "title": "关注度，逗号分隔，例如 key" },
    "start": { "type": "date", "title": "data_end 不早于这个时间（带时区的 ISO 时间）" },
    "end": { "type": "date", "title": "data_end 早于这个时间" },
    "limit": { "type": "number", "title": "最多几条，默认 20" }
  },
  "output": {
    "signals": { "type": "text", "title": "信号列表" },
    "truncated": { "type": "text", "title": "true 表示结果被裁剪过" }
  }
}
