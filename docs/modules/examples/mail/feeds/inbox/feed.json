{
  "title": "收件箱",
  "description": "每 5 分钟查一次 Gmail 收件箱的新信，只收邮件名单上的发件人；名单外的信不存、不通知",
  "handler": "index.ts",
  "secrets": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "GMAIL_READ_REFRESH_TOKEN"],
  "every": "5m",
  "limit": "1m",
  "settings": { "baseUrl": "https://gmail.googleapis.com", "tokenUrl": "https://oauth2.googleapis.com/token" },
  "reads": ["senders"],
  "into": "messages",
  "notice": "{{from}} 来信：{{subject}}。{{snippet}}",
  "line": "{{from}}\n{{subject}}\n{{snippet}}"
}
