{
  "title": "收件箱",
  "description": "每 5 分钟经宿主的 mail 连接器查一次 Gmail 收件箱的新信，只收邮件名单上的发件人；名单外的信不存、不通知",
  "connector": "mail",
  "handler": "index.ts",
  "every": "5m",
  "limit": "1m",
  "settings": { "senders": "senders" },
  "into": "messages",
  "notice": "{{from}} 来信：{{subject}}。{{snippet}}",
  "line": "{{from}}\n{{subject}}\n{{snippet}}"
}
